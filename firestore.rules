rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidFolder(data, folderId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'color', 'icon', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'color', 'icon', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == folderId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.color is string
        && data.color.size() >= 1
        && data.color.size() <= 32
        && data.icon is string
        && data.icon.size() >= 1
        && data.icon.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNote(data, noteId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'folderId',
          'title',
          'slug',
          'content',
          'excerpt',
          'stage',
          'tags',
          'isPinned',
          'isArchived',
          'color',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'folderId',
          'title',
          'slug',
          'content',
          'excerpt',
          'stage',
          'tags',
          'isPinned',
          'isArchived',
          'color',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == noteId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == request.auth.uid
        && (data.folderId == null || (data.folderId is string && isValidId(data.folderId)))
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.slug is string
        && data.slug.size() >= 1
        && data.slug.size() <= 200
        && data.content is string
        && data.content.size() <= 500000
        && data.excerpt is string
        && data.excerpt.size() <= 300
        && data.stage is string
        && data.stage in ['SEED', 'DRAFT', 'REVISION', 'POLISHED']
        && data.tags is list
        && data.tags.size() <= 20
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        && data.isPinned is bool
        && data.isArchived is bool
        && data.color is string
        && data.color.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function ownsFolderIfAssigned(folderId) {
      return folderId == null
        || (exists(/databases/$(database)/documents/folders/$(folderId))
          && get(/databases/$(database)/documents/folders/$(folderId)).data.userId == request.auth.uid);
    }

    function ownsNote(noteId) {
      return exists(/databases/$(database)/documents/notes/$(noteId))
        && get(/databases/$(database)/documents/notes/$(noteId)).data.userId == request.auth.uid;
    }

    function ownsProject(projectId) {
      return exists(/databases/$(database)/documents/folders/$(projectId))
        && get(/databases/$(database)/documents/folders/$(projectId)).data.userId == request.auth.uid;
    }

    function isValidSavedAffirmation(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'projectId',
          'texto',
          'tipo',
          'origen',
          'estado',
          'fuentes',
          'evolucion',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'projectId',
          'texto',
          'tipo',
          'origen',
          'estado',
          'fuentes',
          'evolucion',
          'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.userId is string
        && data.userId == request.auth.uid
        && data.projectId is string
        && isValidId(data.projectId)
        && data.texto is string
        && data.texto.size() >= 1
        && data.texto.size() <= 10000
        && data.tipo is string
        && data.tipo.size() >= 1
        && data.tipo.size() <= 128
        && data.origen is string
        && data.origen in ['usuario', 'asistente', 'compartido']
        && data.estado == 'vigente'
        && data.fuentes is list
        && data.fuentes.size() <= 100
        && data.evolucion is map
        && data.evolucion.keys().hasAll(['tipo', 'antecedentes'])
        && data.evolucion.keys().hasOnly(['tipo', 'antecedentes'])
        && data.evolucion.tipo is string
        && data.evolucion.tipo.size() >= 1
        && data.evolucion.tipo.size() <= 128
        && data.evolucion.antecedentes is list
        && data.evolucion.antecedentes.size() <= 100
        && data.updatedAt is timestamp;
    }

    function isValidComment(data, commentId) {
      return data.keys().hasAll(['id', 'userId', 'noteId', 'content', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'noteId', 'content', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == commentId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == request.auth.uid
        && data.noteId is string
        && isValidId(data.noteId)
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /folders/{folderId} {
      allow get: if isVerifiedUser()
        && isValidId(folderId)
        && existing().userId == request.auth.uid;

      allow list: if isVerifiedUser()
        && existing().userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(folderId)
        && isValidFolder(incoming(), folderId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(folderId)
        && isValidFolder(incoming(), folderId)
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'icon', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(folderId)
        && existing().userId == request.auth.uid;
    }

    match /notes/{noteId} {
      allow get: if isVerifiedUser()
        && isValidId(noteId)
        && existing().userId == request.auth.uid;

      allow list: if isVerifiedUser()
        && existing().userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(noteId)
        && isValidNote(incoming(), noteId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsFolderIfAssigned(incoming().folderId);

      allow update: if isVerifiedUser()
        && isValidId(noteId)
        && isValidNote(incoming(), noteId)
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && ownsFolderIfAssigned(incoming().folderId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'folderId',
          'title',
          'slug',
          'content',
          'excerpt',
          'stage',
          'tags',
          'isPinned',
          'isArchived',
          'color',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(noteId)
        && existing().userId == request.auth.uid;
    }

    match /comments/{commentId} {
      allow get: if isVerifiedUser()
        && isValidId(commentId)
        && existing().userId == request.auth.uid;

      allow list: if isVerifiedUser()
        && existing().userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(commentId)
        && isValidComment(incoming(), commentId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsNote(incoming().noteId);

      allow update: if isVerifiedUser()
        && isValidId(commentId)
        && isValidComment(incoming(), commentId)
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().noteId == existing().noteId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && ownsNote(incoming().noteId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(commentId)
        && existing().userId == request.auth.uid;
    }

    match /affirmations/{affirmationId} {
      allow get: if isVerifiedUser()
        && existing().userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidSavedAffirmation(incoming())
        && incoming().updatedAt == request.time
        && ownsProject(incoming().projectId);

      allow update: if isVerifiedUser()
        && isValidSavedAffirmation(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && ownsProject(incoming().projectId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'projectId',
          'texto',
          'tipo',
          'origen',
          'estado',
          'fuentes',
          'evolucion',
          'updatedAt'
        ]);
    }
  }
}
